/* Aim Companion — calm, high-contrast desktop theme */

QWidget {
    background-color: #0b1020;
    color: #e5eaf5;
    font-family: "Segoe UI", sans-serif;
    font-size: 10pt;
}

QWidget#appRoot,
QWidget#workspace {
    background-color: #0b1020;
}

QLabel {
    background: transparent;
    border: none;
}

/* Application shell */
QFrame#sidebar {
    background-color: #10172a;
    border: none;
    border-right: 1px solid #222c43;
    border-radius: 0;
}

QLabel#brandMark {
    background-color: #8b9cfb;
    color: #07111c;
    border-radius: 10px;
    font-size: 16pt;
    font-weight: 900;
}

QLabel#brandName {
    color: #f8fafc;
    font-size: 10pt;
    font-weight: 800;
    letter-spacing: 1px;
}

QLabel#brandSub,
QLabel#eyebrow,
QLabel#fieldLabel,
QLabel#navSection {
    color: #71809b;
    font-size: 8pt;
    font-weight: 700;
    letter-spacing: 1px;
}

QFrame#rankCard {
    background-color: #151e34;
    border: 1px solid #27334d;
    border-radius: 10px;
    margin-top: 8px;
}

QLabel#rankValue {
    font-size: 17pt;
    font-weight: 800;
}

QLabel#rankMeta {
    color: #95a2b8;
    font-size: 9pt;
}

QScrollArea#navScroll,
QScrollArea#navScroll > QWidget > QWidget {
    background: transparent;
    border: none;
}

QLabel#navSection {
    padding: 9px 8px 3px 8px;
}

QPushButton#navButton {
    background: transparent;
    color: #9ca9bf;
    border: none;
    border-radius: 7px;
    padding: 7px 11px;
    min-height: 18px;
    text-align: left;
    font-weight: 500;
}

QPushButton#navButton:hover {
    background-color: #18233b;
    color: #e5eaf5;
}

QPushButton#navButton:checked {
    background-color: #1b2540;
    color: #b7c0ff;
    border-left: 3px solid #8b9cfb;
    font-weight: 700;
}

QPushButton#sidebarPrimary {
    background-color: #8b9cfb;
    color: #07111c;
    border: none;
    border-radius: 8px;
    padding: 9px 11px;
    margin-top: 2px;
    font-weight: 800;
}

QPushButton#sidebarPrimary:hover {
    background-color: #aeb8ff;
}

QPushButton#sidebarSecondary {
    background-color: #161f33;
    color: #c6cede;
    border: 1px solid #2a3750;
    border-radius: 8px;
    padding: 8px 11px;
    font-weight: 700;
}

QPushButton#sidebarSecondary:hover {
    background-color: #202d47;
    border-color: #465979;
}

QFrame#topbar {
    background-color: #11192b;
    border: 1px solid #222d45;
    border-radius: 12px;
}

QLabel#pageTitle {
    color: #f8fafc;
    font-size: 17pt;
    font-weight: 750;
}

QLabel#pageSubtitle {
    color: #8290a8;
    font-size: 9pt;
}

QStackedWidget#pageStack {
    background: transparent;
    border: none;
}

QFrame#trainingModes {
    background-color: #11192b;
    border: 1px solid #222d45;
    border-radius: 8px;
}

QPushButton#modeButton {
    background-color: transparent;
    color: #95a2b8;
    border: none;
    border-radius: 6px;
    padding: 7px 12px;
}

QPushButton#modeButton:hover {
    background-color: #18233b;
    color: #e5eaf5;
}

QPushButton#modeButton:checked {
    background-color: #293558;
    color: #c4caff;
    font-weight: 800;
}

QFrame#deathmatchMode {
    background-color: #11192b;
    border: 1px solid #263149;
    border-radius: 8px;
}

QFrame#methodNav {
    background-color: #0f1728;
    border: 1px solid #222e45;
    border-radius: 8px;
}

QListWidget#methodList {
    background-color: transparent;
    border: none;
    border-radius: 0;
    padding: 0;
}

QListWidget#methodList::item {
    color: #b9c3d5;
    padding: 10px 9px;
    border-radius: 5px;
}

QListWidget#methodList::item:hover {
    background-color: #172238;
    color: #edf1f8;
}

QListWidget#methodList::item:selected {
    background-color: #293558;
    color: #eef0ff;
    border-left: 3px solid #8b9cfb;
}

QLabel#methodEyebrow,
QLabel#methodSection {
    color: #8fa4cf;
    font-size: 8pt;
    font-weight: 800;
}

QLabel#methodTitle {
    color: #f4f6fb;
    font-size: 18pt;
    font-weight: 750;
}

QLabel#methodSummary {
    color: #aeb8ca;
    font-size: 11pt;
}

QLabel#methodBody {
    color: #d3d9e5;
    font-size: 10pt;
}

QFrame#methodWarning {
    background-color: #151a28;
    border: 1px solid #3a3544;
    border-radius: 7px;
}

QFrame#sourceRoutineGuide {
    background-color: #111b28;
    border: 1px solid #31566a;
    border-left: 3px solid #70c1b3;
    border-radius: 7px;
}

QLabel#modeSummary {
    color: #cdd6f4;
    font-weight: 700;
}

QLabel#modeProgress {
    color: #a6e3a1;
    font-weight: 800;
}

QLabel#modeGuidance {
    color: #94e2d5;
}

/* Cards and content surfaces */
QFrame {
    background: transparent;
    border: none;
}

QScrollArea {
    background: transparent;
    border: none;
}

QScrollArea > QWidget > QWidget {
    background-color: #0b1020;
}

/* Inputs */
QComboBox,
QSpinBox,
QDoubleSpinBox,
QDateEdit,
QLineEdit,
QTextEdit,
QPlainTextEdit {
    background-color: #0d1527;
    color: #e5eaf5;
    border: 1px solid #31405e;
    border-radius: 7px;
    padding: 6px 10px;
    min-height: 19px;
    selection-background-color: #2563eb;
}

QComboBox:hover,
QSpinBox:hover,
QDoubleSpinBox:hover,
QDateEdit:hover,
QLineEdit:hover {
    border-color: #526581;
}

QComboBox:focus,
QSpinBox:focus,
QDoubleSpinBox:focus,
QDateEdit:focus,
QLineEdit:focus,
QTextEdit:focus,
QPlainTextEdit:focus {
    border: 1px solid #8b9cfb;
}

QComboBox::drop-down,
QDateEdit::drop-down {
    border: none;
    width: 24px;
}

QComboBox QAbstractItemView {
    background-color: #121b2e;
    color: #e5eaf5;
    border: 1px solid #31405e;
    selection-background-color: #1e3a5f;
    selection-color: #c4caff;
    padding: 4px;
}

QSpinBox::up-button,
QSpinBox::down-button,
QDoubleSpinBox::up-button,
QDoubleSpinBox::down-button {
    subcontrol-origin: border;
    width: 20px;
    border: none;
    background-color: #1b2740;
}

/* Buttons */
QPushButton {
    background-color: #1b2740;
    color: #e5eaf5;
    border: 1px solid #33415e;
    border-radius: 7px;
    padding: 8px 14px;
    min-height: 19px;
    font-weight: 650;
}

QPushButton:hover {
    background-color: #263553;
    border-color: #526581;
}

QPushButton:pressed {
    background-color: #111b30;
}

QPushButton:focus,
QCheckBox:focus,
QRadioButton:focus,
QTabBar::tab:focus {
    border: 2px solid #89b4fa;
}

QPushButton:disabled {
    background-color: #141c2d;
    color: #56637a;
    border-color: #222c40;
}

QPushButton#primaryButton,
QPushButton#launchButton {
    background-color: #8b9cfb;
    color: #07111c;
    border: none;
    padding: 8px 16px;
    font-weight: 800;
}

QPushButton#primaryButton:hover,
QPushButton#launchButton:hover {
    background-color: #aeb8ff;
}

QPushButton#secondaryButton {
    background-color: #172238;
}

QCheckBox,
QRadioButton {
    color: #c4ccda;
    spacing: 7px;
}

QCheckBox::indicator,
QRadioButton::indicator {
    width: 16px;
    height: 16px;
    background-color: #0d1527;
    border: 1px solid #3a4965;
    border-radius: 4px;
}

QCheckBox::indicator:hover,
QRadioButton::indicator:hover {
    border-color: #8b9cfb;
}

QCheckBox::indicator:checked,
QRadioButton::indicator:checked {
    background-color: #8b9cfb;
    border-color: #a8b3ff;
}

/* Data widgets */
QProgressBar {
    background-color: #0c1424;
    border: 1px solid #26334d;
    border-radius: 5px;
    height: 10px;
    text-align: center;
    color: transparent;
}

QProgressBar::chunk {
    background-color: #7c8cff;
    border-radius: 4px;
}

QListWidget,
QTableWidget,
QTreeWidget {
    background-color: #0d1527;
    alternate-background-color: #111b2f;
    color: #dfe6f2;
    border: 1px solid #27344e;
    border-radius: 8px;
    outline: none;
    padding: 4px;
}

QListWidget::item,
QTreeWidget::item {
    padding: 7px;
    border-radius: 5px;
}

QListWidget::item:selected,
QTreeWidget::item:selected,
QTableWidget::item:selected {
    background-color: #1c3a57;
    color: #c4caff;
}

QHeaderView::section {
    background-color: #151f34;
    color: #8fa0b8;
    border: none;
    border-bottom: 1px solid #2c3851;
    padding: 7px;
    font-weight: 700;
}

/* Legacy tabs can still appear inside individual tools */
QTabWidget::pane {
    background-color: #10182a;
    border: 1px solid #253149;
    border-radius: 8px;
}

QTabBar::tab {
    background: transparent;
    color: #8492a8;
    border: none;
    padding: 9px 14px;
}

QTabBar::tab:selected {
    color: #c4caff;
    border-bottom: 2px solid #8b9cfb;
    font-weight: 700;
}

QTabBar::tab:hover:!selected {
    color: #d9e2ef;
}

/* Feedback and chrome */
QToolTip {
    background-color: #1b2740;
    color: #f1f5f9;
    border: 1px solid #40506d;
    border-radius: 5px;
    padding: 6px 9px;
}

QStatusBar {
    background-color: #0e1627;
    color: #7f8da4;
    border-top: 1px solid #222d45;
    padding: 3px 10px;
    font-size: 9pt;
}

QMenuBar,
QMenu {
    background-color: #111a2c;
    color: #e5eaf5;
}

QMenu {
    border: 1px solid #2c3953;
    padding: 4px;
}

QMenu::item {
    padding: 7px 24px;
    border-radius: 4px;
}

QMenu::item:selected {
    background-color: #1c3a57;
    color: #c4caff;
}

QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 1px;
}

QScrollBar::handle:vertical {
    background-color: #34435e;
    min-height: 28px;
    border-radius: 4px;
}

QScrollBar::handle:vertical:hover {
    background-color: #50617e;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical,
QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: transparent;
    border: none;
    height: 0;
}

QScrollBar:horizontal {
    background: transparent;
    height: 10px;
}

QScrollBar::handle:horizontal {
    background-color: #34435e;
    min-width: 28px;
    border-radius: 4px;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0;
    border: none;
}

/* Home page */
QFrame#homeFocusCard {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 1, y2: 1,
        stop: 0 #151e35, stop: 0.68 #111a2e, stop: 1 #17213a
    );
    border: 1px solid #33415f;
    border-left: 4px solid #8b9cfb;
    border-radius: 14px;
}

QFrame#homeRankPanel {
    background-color: #0d1528;
    border: 1px solid #2b3854;
    border-radius: 11px;
}

QLabel#homeEyebrow,
QLabel#trainingModeEyebrow,
QLabel#homeFactCaption {
    color: #8f9fcb;
    font-size: 8pt;
    font-weight: 800;
    letter-spacing: 1px;
}

QLabel#homeFocusTitle {
    color: #f8fafc;
    font-size: 20pt;
    font-weight: 800;
}

QLabel#homeSupportingText {
    color: #98a6bd;
    font-size: 9pt;
}

QFrame#homeFact {
    background-color: rgba(11, 17, 32, 150);
    border: 1px solid #2d3b59;
    border-radius: 8px;
}

QLabel#homeFactValue {
    color: #edf1f8;
    font-size: 10pt;
    font-weight: 700;
}

QLabel#homeRankValue {
    color: #f1d6a8;
    font-size: 17pt;
    font-weight: 850;
}

QFrame#primaryActionPanel,
QFrame#homeInsights {
    background: transparent;
    border: none;
}

QFrame#trainingModeCard {
    background-color: #11192b;
    border: 1px solid #293651;
    border-radius: 12px;
}

QFrame#trainingModeCard:hover {
    background-color: #151f34;
    border-color: #465979;
}

QFrame#trainingModeCard[recommended="true"] {
    background-color: #151d35;
    border: 1px solid #6f7fd5;
}

QLabel#recommendedBadge {
    background-color: #29365f;
    color: #cbd1ff;
    border: 1px solid #5969ae;
    border-radius: 7px;
    padding: 3px 7px;
    font-size: 7pt;
    font-weight: 850;
}

QLabel#trainingModeTitle {
    color: #f4f6fb;
    font-size: 13pt;
    font-weight: 780;
}

QLabel#trainingModeDescription {
    color: #c2cad8;
    font-size: 9pt;
}

QLabel#trainingModeMeta {
    color: #7f8da7;
    font-size: 8pt;
    font-weight: 650;
}

QPushButton#modeStartButton {
    background-color: #18243b;
    border: 1px solid #394965;
    color: #e8edf6;
    font-weight: 750;
}

QPushButton#modeStartButton:hover {
    background-color: #243451;
    border-color: #60718f;
}

QFrame#homeInsightCard {
    background-color: #0f1728;
    border: 1px solid #26334d;
    border-radius: 11px;
}

QLabel#homeCardTitle {
    color: #edf1f8;
    font-size: 11pt;
    font-weight: 750;
}

QLabel#homeInsightBody {
    color: #c9d2e2;
    font-size: 9pt;
}

QWidget#statusIndicator {
    background-color: #0f1728;
    border: 1px solid #26334d;
    border-radius: 9px;
}

QWidget#statusIndicator QPushButton {
    background-color: transparent;
    border: none;
    color: #aeb8ff;
    min-height: 16px;
    padding: 4px 8px;
}

QWidget#statusIndicator QPushButton:hover {
    background-color: #1b2740;
}

QFrame#homeHero {
    background-color: #121a2c;
    border: 1px solid #263149;
    border-radius: 14px;
}

QLabel#homeRank {
    background: transparent;
    border: none;
    font-size: 30pt;
    font-weight: 800;
}

QLabel#homeEnergy {
    background: transparent;
    border: none;
    color: #e4e8f2;
    font-size: 13pt;
    font-weight: 650;
}

QLabel#mutedText {
    background: transparent;
    border: none;
    color: #8996ab;
}

QFrame#focusPanel {
    background-color: #171e36;
    border: 1px solid #313c59;
    border-radius: 10px;
}

QLabel#focusTitle {
    background: transparent;
    border: none;
    color: #f1f3f9;
    font-size: 17pt;
    font-weight: 750;
}

QLabel#sectionTitle {
    background: transparent;
    border: none;
    color: #f1f3f9;
    font-size: 15pt;
    font-weight: 750;
}

QFrame#skillCard {
    background-color: #11192b;
    border: 1px solid #263149;
    border-radius: 11px;
}

QLabel#skillName {
    background: transparent;
    border: none;
    color: #f0f3f8;
    font-size: 12pt;
    font-weight: 700;
}

QLabel#tierPill {
    background: transparent;
    border: none;
    font-weight: 700;
}

QLabel#skillSubName {
    background: transparent;
    border: none;
    color: #aeb8c8;
}

QLabel#skillValue {
    background: transparent;
    border: none;
    color: #d9deea;
    font-weight: 700;
}

QFrame#nextSteps {
    background-color: #0f1728;
    border: 1px solid #222e45;
    border-radius: 10px;
}

/* Focused learning and routine surfaces */
QFrame#guideSummary,
QFrame#guideDetail {
    background-color: #0f182b;
    border: none;
    border-radius: 9px;
}

QFrame#guideSummary {
    min-height: 62px;
}

QFrame#guideDetail {
    margin-top: 4px;
    border-left: 3px solid #33415e;
}

QFrame#routineGuide {
    background-color: #0d1527;
    border: 1px solid #2d3d5c;
    border-radius: 9px;
}

QFrame#quickTraining {
    background-color: #11192b;
    border: 1px solid #263149;
    border-radius: 12px;
}

QLabel#smallTitle {
    background: transparent;
    border: none;
    color: #e9edf5;
    font-size: 11pt;
    font-weight: 700;
}

QPushButton#textButton {
    background: transparent;
    color: #aeb8ff;
    border: none;
    padding: 7px 4px;
}

QPushButton#textButton:hover {
    color: #d7dcff;
}

QPushButton#quietButton,
QToolButton#quietButton {
    background-color: #161f33;
    color: #c6cede;
    border: 1px solid #2a3750;
    border-radius: 7px;
    padding: 8px 14px;
}

/* Guided session */
QStackedWidget#sessionStack,
QWidget#sessionEmptyState,
QWidget#sessionContent,
QScrollArea#sessionScroll,
QScrollArea#sessionScroll > QWidget > QWidget {
    background: transparent;
    border: none;
}

QFrame#sessionEmptyHero,
QFrame#sessionHero {
    background-color: #121b30;
    border: 1px solid #2a3854;
    border-radius: 13px;
}

QFrame#sessionHero {
    border-left: 3px solid #8b9cfb;
}

QLabel#sessionEyebrow,
QLabel#sessionGuideSectionTitle {
    color: #8fa4cf;
    font-size: 8pt;
    font-weight: 800;
    letter-spacing: 1px;
}

QLabel#sessionEmptyTitle {
    color: #f7f9fd;
    font-size: 22pt;
    font-weight: 800;
}

QLabel#sessionTitle {
    color: #f7f9fd;
    font-size: 18pt;
    font-weight: 780;
}

QLabel#sessionModeTitle,
QLabel#sessionQueueTitle {
    color: #f1f4fa;
    font-size: 13pt;
    font-weight: 750;
}

QLabel#sessionSupportingText,
QLabel#sessionPosition,
QLabel#sessionOptionLabel {
    color: #9eabc0;
}

QFrame#sessionModeCard,
QFrame#sessionGuideCard,
QFrame#sessionQueueCard,
QFrame#sessionControls {
    background-color: #10192b;
    border: 1px solid #273550;
    border-radius: 12px;
}

QFrame#sessionModeCard[featured="true"] {
    background-color: #151f38;
    border: 1px solid #6677d9;
}

QFrame#sessionProgressSummary {
    background-color: #0c1528;
    border: 1px solid #2d3b58;
    border-radius: 9px;
    min-width: 190px;
}

QLabel#sessionStatusPill {
    color: #a6e3a1;
    font-size: 9pt;
    font-weight: 850;
    letter-spacing: 1px;
}

QLabel#sessionScenarioTitle {
    color: #ffffff;
    font-size: 21pt;
    font-weight: 800;
}

QFrame#sessionGuideSection {
    background-color: #0c1527;
    border: 1px solid #25334c;
    border-radius: 8px;
}

QLabel#sessionGuideSectionBody {
    color: #d9e0ec;
    font-size: 10pt;
    line-height: 1.35;
}

QProgressBar#sessionRunProgress {
    background-color: #091120;
    color: #eef0ff;
    border: 1px solid #324361;
    border-radius: 7px;
    min-height: 22px;
    font-weight: 750;
}

QProgressBar#sessionRunProgress::chunk {
    background-color: #7889ef;
    border-radius: 6px;
}

QPushButton#sessionSourceButton {
    background: transparent;
    color: #aeb8ff;
    border: 1px solid #39486a;
    padding: 7px 12px;
}

QPushButton#sessionSourceButton:hover {
    background-color: #1a2640;
    border-color: #7889ef;
}

QListWidget#sessionRoutineList {
    background-color: #0b1425;
    border: none;
    border-radius: 8px;
    padding: 6px;
    min-width: 340px;
}

QListWidget#sessionRoutineList::item {
    color: #cdd5e4;
    border-bottom: 1px solid #202d44;
    border-radius: 5px;
    padding: 11px 9px;
}

QListWidget#sessionRoutineList::item:hover {
    background-color: #16223a;
}

QListWidget#sessionRoutineList::item:selected {
    background-color: #202d4d;
    color: #f3f5ff;
    border-left: 3px solid #8b9cfb;
}

QLabel#sessionWarning {
    background-color: #2a2015;
    color: #f4d39a;
    border: 1px solid #604b2d;
    border-radius: 7px;
    padding: 10px 12px;
}

QPushButton#dangerButton {
    background-color: #211722;
    color: #f2b8c0;
    border-color: #5c3441;
}

QPushButton#dangerButton:hover {
    background-color: #3a2029;
    border-color: #a15364;
}

QPushButton#dangerButton:disabled {
    background-color: #17151d;
    color: #654e58;
    border-color: #30232a;
}

/* QLabel inherits QFrame in Qt. Keep generic frame rules away from text. */
QLabel {
    background: transparent;
    border: none;
    border-radius: 0;
}
